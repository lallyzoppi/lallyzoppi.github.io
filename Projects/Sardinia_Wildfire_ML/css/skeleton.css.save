html {
font-size:62.5%;
}


body {

font-size:1.5em;
line-height:1.6;
font-weight:400;

font-family:
"Instrument Sans",
Helvetica,
Arial,
sans-serif;

color:#222;

text-align:justify;

}



.container {

max-width:1280px;

width:85%;

margin:auto;

padding:0;

}



.column,
.columns {

float:left;

box-sizing:border-box;

}



.three.columns {

width:30%;

}



.nine.columns {

width:66%;

margin-left:4%;

}



@media(max-width:750px){

.three.columns,
.nine.columns {

width:100%;

margin-left:0;

}

}



h3 {

font-family:"Boldonse",Arial;

font-size:3.6rem;

color:#1E3A8A;

}



h4 {

font-size:2.8rem;

color: black;

}



h5 {

font-size:2rem;

letter-spacing:.08rem;

margin: 0;

line-height: 1.2;

}



a {

color:#3B82F6;

text-decoration:none;

}



a:hover {

color:#FE693E;

}



.section {

margin-bottom:8rem;

}



hr {

border:0;

border-top:1px solid #ddd;

margin:3rem 0;

}



.media {

display:flex;

gap:3rem;

align-items:flex-start;

margin-bottom:5rem;

}



.media-thumb {

flex:0 0 420px;

}



.media-thumb img {

width:100%;

height:auto;

}



.media-body {

flex:1;

}



.media-body p {

margin-top: 0.5rem;

line-height:1.6;

}



pre {

background:#f5f5f5;

padding:2rem;

border-radius:6px;

font-family:"Inconsolata",monospace;

}



footer {

margin-top:10rem;

text-align:center;

color:#777;

}



strong {

color:#FE693E;

}
